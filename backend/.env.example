
DATABASE_URL=sqlite:///./app.db


GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Firebase Auth - project id only; makes the API require student login
FIREBASE_PROJECT_ID=
# Firebase Storage (optional, needs a service account file)
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_PATH=REPLACE_WITH_PATH_TO_serviceAccount.json
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_PROJECT_ID.appspot.com
MODERATION_API_KEY=REPLACE_WITH_MODERATION_API_KEY
STORAGE_DIR=./generated
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ---- Print queue ----
PRINT_DAILY_PAGE_LIMIT=30
PRINT_MAX_PAGES_PER_JOB=20
PRINT_MAX_COPIES=5
# Optional SHARED printer: none | mock | cups | agent  (see app/printing/backends.py)
# Students can always print to their own printer from the browser.
PRINTER_BACKEND=none
PRINTER_NAME=
PRINT_AGENT_TOKEN=REPLACE_WITH_PRINT_AGENT_TOKEN
